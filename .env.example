# Local development: copy this file to .env (already gitignored) and fill in real values.
# Production: set these through your platform's secret manager (e.g. Render/Railway/Fly
# environment variables) - never via a checked-in .env file, and never reuse a dev/CI value
# (see .github/workflows/ci.yml, which uses its own throwaway DATABASE_URL/JWT_SECRET_KEY
# that must never be used anywhere else). database/seed.sql's demo accounts and passwords
# (see docs/AUTH_DEMO_CREDENTIALS.md) must never be applied to a production database -
# scripts/init_db.py deliberately applies database/schema.sql only, never seed.sql.

DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ai_secureiot
# Production managed Postgres providers typically require TLS - append ?sslmode=require
# to DATABASE_URL if your provider needs it (check their connection-string docs).

# Secret used to sign JWT access tokens. Generate a unique random value per
# environment, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never reuse the same value across environments or commit a real value here.
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY

# Optional: access token lifetime in minutes. Defaults to 60 if unset.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API key for the AI provider (Anthropic). Required only for the /api/v1/ai/* endpoints -
# the rest of the API works without it. Never commit a real key.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional: overrides for the AI Opportunity Intelligence feature.
AI_MODEL=claude-sonnet-5
AI_REQUEST_TIMEOUT_SECONDS=20
