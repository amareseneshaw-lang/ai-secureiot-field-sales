# Copy to .env for local use or set this value through your deployment's secret manager.
# Do not commit a real .env file.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ai_secureiot

# Secret used to sign JWT access tokens. Generate a unique random value per
# environment, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never reuse the same value across environments or commit a real value here.
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY

# Optional: access token lifetime in minutes. Defaults to 60 if unset.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
